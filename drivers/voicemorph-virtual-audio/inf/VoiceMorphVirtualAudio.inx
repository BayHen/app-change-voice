[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=10/23/2026,0.1.0.0
CatalogFile=VoiceMorphVirtualAudio.cat
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
VoiceMorphVirtualAudio.sys=1

[DestinationDirs]
VoiceMorph.CopyFiles=13

[VoiceMorph.CopyFiles]
VoiceMorphVirtualAudio.sys

[Manufacturer]
%ManufacturerName%=VoiceMorph,NTamd64.10.0...19041

[VoiceMorph.NTamd64.10.0...19041]
%DeviceDescription%=VoiceMorph_Install,ROOT\VoiceMorphVirtualMicrophone

[VoiceMorph_Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=VoiceMorph.CopyFiles
AddReg=VoiceMorph.AddReg

[VoiceMorph.AddReg]
HKR,,AssociatedFilters,0x00000000,"wdmaud"
HKR,,Driver,0x00000000,VoiceMorphVirtualAudio.sys
HKR,Drivers,SubClasses,0x00000000,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,0x00000000,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,0x00000000,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,0x00000000,%DeviceDescription%
HKR,Drivers\mixer\wdmaud.drv,Description,0x00000000,%DeviceDescription%
HKR,PowerSettings,SingleComponentMultiFxStates,0x00010001,0

[VoiceMorph_Install.NT.Interfaces]
AddInterface=%VoiceMorphBridgeInterface%,GLOBAL,VoiceMorph.Bridge
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveMic%,VoiceMorph.WaveMic
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveMic%,VoiceMorph.WaveMic
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveMic%,VoiceMorph.WaveMic
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyMic%,VoiceMorph.TopologyMic
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMic%,VoiceMorph.TopologyMic

[VoiceMorph.Bridge]
AddReg=VoiceMorph.Bridge.AddReg

[VoiceMorph.Bridge.AddReg]
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGW;;;AU)"

[VoiceMorph.WaveMic]
AddReg=VoiceMorph.WaveMic.AddReg

[VoiceMorph.WaveMic.AddReg]
HKR,,CLSID,0x00000000,%Proxy.CLSID%
HKR,,FriendlyName,0x00000000,%WaveFriendlyName%

[VoiceMorph.TopologyMic]
AddReg=VoiceMorph.TopologyMic.AddReg

[VoiceMorph.TopologyMic.AddReg]
HKR,,CLSID,0x00000000,%Proxy.CLSID%
HKR,,FriendlyName,0x00000000,%TopologyFriendlyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,0x00000000,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[VoiceMorph_Install.NT.Services]
AddService=VoiceMorphVirtualAudio,0x00000002,VoiceMorph_Service

[VoiceMorph_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VoiceMorphVirtualAudio.sys

[VoiceMorph_Install.NT.HW]
AddReg=VoiceMorph.Hardware

[VoiceMorph.Hardware]
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGX;;;WD)(A;;GRGX;;;RC)"

[VoiceMorph_Install.NT.Wdf]
KmdfService=VoiceMorphVirtualAudio,VoiceMorph_Wdf

[VoiceMorph_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="VoiceMorph Studio"
ManufacturerName="VoiceMorph Studio"
DeviceDescription="VoiceMorph Virtual Microphone"
ServiceDescription="VoiceMorph Virtual Microphone Driver"
DiskName="VoiceMorph Virtual Microphone Driver Package"
WaveFriendlyName="VoiceMorph Virtual Microphone Wave"
TopologyFriendlyName="VoiceMorph Virtual Microphone Topology"
KSNAME_WaveMic="WaveMicArray1"
KSNAME_TopologyMic="TopologyMicArray1"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
VoiceMorphBridgeInterface="{B566F7B7-91D8-4F31-9712-94C55A10E52A}"
