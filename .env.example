# URL API trong tương lai. Task 01 chưa kết nối dịch vụ bên ngoài.
VITE_API_BASE_URL=http://localhost:3000

# Updater signing is injected at Rust compile time for release builds.
# Store the private key only in GitHub Actions secrets, never in this file.
# VOICEMORPH_UPDATER_PUBLIC_KEY="public key content"
# TAURI_SIGNING_PRIVATE_KEY="private key content or secure path"
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
