{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceMorph Studio",
  "version": "0.1.0",
  "identifier": "com.voicemorph.studio",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceMorph Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "VoiceMorph Studio Contributors",
    "homepage": "https://github.com/BayHen/app-change-voice",
    "copyright": "Copyright © 2026 VoiceMorph Studio Contributors",
    "category": "Music",
    "shortDescription": "Local real-time voice processing studio",
    "longDescription": "VoiceMorph Studio processes microphone audio locally and can route processed voice to compatible virtual audio devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BayHen/app-change-voice/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
